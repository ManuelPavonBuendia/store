@startuml
    skinparam monochrome true
    autonumber

    actor Cliente
    participant PokemonController
    participant PokemonMapper
    participant CreatePokemonService
    participant CreatePokemonUseCase

    Cliente -> PokemonController : POST /pokemons (nombre, tipo, foto, precio)
    PokemonController -> PokemonMapper : toCommand(request)
    PokemonMapper -->> PokemonController : CreatePokemonCommand
    PokemonController -> CreatePokemonService : createPokemon(comando)
    CreatePokemonService -> CreatePokemonUseCase : create(comando)
    CreatePokemonUseCase -> CreatePokemonUseCase : crea el Pokemon (createdAt = now)
    CreatePokemonUseCase -->> CreatePokemonService : Pokemon
    CreatePokemonService -->> PokemonController : Pokemon
    PokemonController -->> Cliente : HTML con los datos
@enduml
